####################################
#### MindineersOS Configuration ####
#### by Mindineers Labs          ####
####################################

####################################
####   Server Configuration     ####
####################################

# Server Port
SERVER_PORT=3000

# Server Host (default: 0.0.0.0)
SERVER_HOST=

# Environment Mode (development/production)
NODE_ENV=development

# Controls whether the web UI is available
# Set to "true" to force enable, "false" to force disable
# Default: enabled in development, disabled in production
MINDINEERS_OS_UI_ENABLE=

# Server authentication token for API access
# When set, all /api/* routes require X-API-KEY header with this value
MINDINEERS_OS_SERVER_AUTH_TOKEN=

# Express Maximum Payload Size (default: 2mb)
EXPRESS_MAX_PAYLOAD=2mb

####################################
####  Provider Configuration    ####
####################################

# Total timeout for all providers running in parallel (ms)
# Default: 1000 (1 second)
PROVIDERS_TOTAL_TIMEOUT_MS=1000

####################################
####  Database Configuration    ####
####################################

# PostgreSQL Connection URL (Supabase recommended)
# Get yours at: https://supabase.com → Project → Settings → Database → Connection String
POSTGRES_URL=

# PGLite Database Directory (local alternative to Postgres)
# Use memory:// for in-memory, or a path like ./.mindineersos/pglite
PGLITE_DATA_DIR=

####################################
#### AI Model Provider APIs     ####
####################################

# Google Gemini — PRIMARY PROVIDER (free tier available)
# Get your key at: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenAI API Key (alternative provider)
OPENAI_API_KEY=

# Anthropic Claude API Key (alternative provider)
ANTHROPIC_API_KEY=

# OpenRouter API Key (multi-model gateway)
OPENROUTER_API_KEY=

# Ollama API Endpoint (local LLM hosting)
OLLAMA_API_ENDPOINT=

####################################
####  Character & Content       ####
####################################

# Remote Character URLs (comma-separated)
REMOTE_CHARACTER_URLS=

####################################
####  Development & Build       ####
####################################

# Non-interactive CLI Mode (true/false)
MINDINEERS_OS_NONINTERACTIVE=

####################################
####  Data Directory Config     ####
####################################

# Base data directory (default: .mindineersos)
# MINDINEERS_OS_DATA_DIR=.mindineersos

# Database directory (default: {MINDINEERS_OS_DATA_DIR}/.mindineersosdb)
# MINDINEERS_OS_DATABASE_DIR=

# Characters storage directory
# MINDINEERS_OS_DATA_DIR_CHARACTERS=

# AI-generated content directory
# MINDINEERS_OS_DATA_DIR_GENERATED=

####################################
####  Plugin Control             ####
####################################
# Check agentConfig property on each plugin's package.json
# for available / required configuration

####################################
####  Coding Sandbox Routing     ####
####################################

# Active options: e2b, mindineersos-cloud, home
MINDINEERS_OS_CODING_REMOTE_RUNNER=

# Shared sandbox settings
MINDINEERS_OS_SANDBOX_WORKDIR=
MINDINEERS_OS_SANDBOX_HOST_WORKSPACE_ROOT=
MINDINEERS_OS_SANDBOX_AGENT_RUNNERS=

# E2B sandbox
E2B_API_KEY=
E2B_ACCESS_TOKEN=
E2B_SANDBOX_ID=
E2B_TEMPLATE=

# Cloud sandbox runner
MINDINEERS_OS_CLOUD_SANDBOX_API_BASE_URL=
MINDINEERS_OS_CLOUD_SANDBOX_BASE_URL=
MINDINEERS_OS_CLOUD_SANDBOX_TOKEN=
MINDINEERS_OS_CLOUD_SANDBOX_ACCESS_URL=
MINDINEERS_OS_CLOUD_SANDBOX_IMAGE=
MINDINEERS_OS_CLOUD_REMOTE_RUNNER_IMAGE=
MINDINEERS_OS_CLOUD_CODING_REMOTE_RUNNER_IMAGE=

# Home Remote runner
MINDINEERS_OS_HOME_REMOTE_RUNNER_URL=
MINDINEERS_OS_HOME_REMOTE_RUNNER_TOKEN=
MINDINEERS_OS_HOME_REMOTE_RUNNER_ACCESS_URL=
