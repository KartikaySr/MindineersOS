{
  "name": "mindineers-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import tsx --test tests/*.test.mjs",
    "generate:schema": "node scripts/generate-schema-validator.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^6.4.1"
  },
  "engines": {
    "node": "24.x"
  }
}
